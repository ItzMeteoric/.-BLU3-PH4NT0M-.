-- Draggable with screen bounds
local dragging = false
local dragStartPos = nil
local dragStartOffset = nil

FB.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStartPos = input.Position
        dragStartOffset = FB.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartPos
        local newX = dragStartOffset.X.Offset + delta.X
        local newY = dragStartOffset.Y.Offset + delta.Y
        
        local screenSize = UIS:GetMouseLocation()
        newX = math.clamp(newX, 10, screenSize.X - 90)
        newY = math.clamp(newY, 10, screenSize.Y - 95)
        
        FB.Position = UDim2.new(dragStartOffset.X.Scale, newX, dragStartOffset.Y.Scale, newY)
    end
end)

