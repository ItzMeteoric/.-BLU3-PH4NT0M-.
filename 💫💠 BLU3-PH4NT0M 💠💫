local function addLoot(part, name, id)
    if lootTagged[id] then return end
    local bill = Instance.new("BillboardGui") bill.Name="LootESP" bill.Size=UDim2.new(0,140,0,28) bill.StudsOffset=Vector3.new(0,1.5,0) bill.AlwaysOnTop=true bill.Parent=part
    local bg = Instance.new("Frame") bg.Size=UDim2.new(1,0,1,0) bg.BackgroundColor3=Color3.fromRGB(0,0,0) bg.BackgroundTransparency=0.4 bg.Parent=bill
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0,4)
    local txt = Instance.new("TextLabel") txt.Size=UDim2.new(1,0,1,0) txt.BackgroundTransparency=1 txt.Text="💫 "..name txt.TextColor3=Color3.fromRGB(255,200,100) txt.TextSize=11 txt.Font=Enum.Font.GothamBold txt.Parent=bill
    lootTagged[id] = true
end

local function scan()
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") and obj and not obj:IsDescendantOf(PL.Character) then
            if obj:FindFirstChild("LootESP") then continue end
            local name = obj.Name
            if obj.Parent and obj.Parent:IsA("Tool") then name = obj.Parent.Name end
            name = string.gsub(name, "[%d_]", "")
            local low = string.lower(name)
            local good = false
            if low:find("pistol") or low:find("shotgun") or low:find("bat") or low:find("cricket") or low:find("hammer") or low:find("eoka") or low:find("makeshift") then good = true end
            if low:find("ammo") or low:find("bullet") or low:find("shell") then good = true end
            if low:find("bandage") or low:find("med") or low:find("health") then good = true end
            local junk = low:find("desert") or low:find("chunk") or low:find("plastic") or low:find("wood") or low:find("plank") or low:find("water") or low:find("mesh")
            if good and not junk and #name > 2 then
                local clean = string.upper(string.sub(name,1,1)) .. string.sub(string.lower(name),2)
                addLoot(obj, clean, tostring(obj))
            end
        end
    end
end

