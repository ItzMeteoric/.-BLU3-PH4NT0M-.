-- MARK CURRENT BARREL AS EMPTY (SO YOU NEVER GO BACK)
local function markCurrent()
    if currentTarget then
        local id = getBarrelId(currentTarget)
        markedBarrels[id] = true
        local n = Instance.new("TextLabel") n.Size=UDim2.new(0,220,0,30) n.Position=UDim2.new(0.5,-110,0.5,-50) n.BackgroundColor3=Color3.fromRGB(0,150,100) n.BackgroundTransparency=0.3 n.Text="🗑️ MARKED! Won't teleport here again" n.TextColor3=Color3.fromRGB(255,255,255) n.TextSize=11 n.Font=Enum.Font.GothamBold n.Parent=MG
        Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
        task.wait(1.5) n:Destroy()
        currentTarget = nil
    else
        -- Try to mark nearest barrel even if not teleported
        local c = PL.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r then
            local closest = nil
            local closestDist = 15
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local n = string.lower(obj.Name)
                    if n:find("barrel") or n:find("crate") then
                        local d = (obj.Position - r.Position).Magnitude
                        if d < closestDist then
                            closestDist = d
                            closest = obj
                        end
                    end
                end
            end
            if closest then
