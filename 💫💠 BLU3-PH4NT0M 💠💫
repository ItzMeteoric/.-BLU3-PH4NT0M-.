-- TELEPORT TO NEAREST UNMARKED LOOT (FIXED - marks as empty)
local function teleportToLoot()
    local c = PL.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    
    local closest, closestDist = nil, math.huge
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            if n:find("barrel") or n:find("crate") or n:find("chest") then
                if obj.Parent and not obj.Parent:IsA("Player") then
                    local id = getBarrelId(obj)
                    if not markedBarrels[id] then
                        local d = (obj.Position - r.Position).Magnitude
                        if d < closestDist then
                            closestDist = d
                            closest = obj
                        end
                    end
                end
            end
        end
    end
    
    if closest then
        currentTarget = closest
        r.CFrame = CFrame.new(closest.Position + Vector3.new(0, 2, 0))
        local n = Instance.new("TextLabel") n.Size=UDim2.new(0,220,0,30) n.Position=UDim2.new(0.5,-110,0.5,-50) n.BackgroundColor3=Color3.fromRGB(0,150,100) n.BackgroundTransparency=0.3 n.Text="🎯 TELEPORTED! Press MARK AS EMPTY when done" n.TextColor3=Color3.fromRGB(255,255,255) n.TextSize=10 n.Font=Enum.Font.GothamBold n.Parent=MG
        Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
        task.wait(2) n:Destroy()
    else
        local n = Instance.new("TextLabel") n.Size=UDim2.new(0,220,0,30) n.Position=UDim2.new(0.5,-110,0.5,-50) n.BackgroundColor3=Color3.fromRGB(150,50,50) n.BackgroundTransparency=0.3 n.Text="❌ NO UNMARKED LOOT!" n.TextColor3=Color3.fromRGB(255,255,255) n.TextSize=11 n.Font=Enum.Font.GothamBold n.Parent=MG
