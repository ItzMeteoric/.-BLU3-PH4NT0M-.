local function findRaftOrSail()
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            if n:find("raft") or n:find("sail") or n:find("mast") or n:find("foundation") or n:find("floor") or n:find("platform") then
                if obj.Parent and not obj.Parent:IsA("Player") then
                    return obj
                end
            end
        end
    end
    return nil
end

