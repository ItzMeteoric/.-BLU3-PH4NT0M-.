        clearLoot()
        if lootConnection then lootConnection:Disconnect() end
        lootConnection = RS.RenderStepped:Connect(scan)
    else
        lbtn.Text = "OFF" lbtn.BackgroundColor3 = Color3.fromRGB(0,80,160)
        if lootConnection then lootConnection:Disconnect() end
        clearLoot()
    end
end)

