local function clearLoot()
    for id, info in pairs(lootTagged) do if info and info.bill then info.bill:Destroy() end end
    lootTagged = {}
    for _, v in ipairs(WS:GetDescendants()) do if v:FindFirstChild("LootESP") then v.LootESP:Destroy() end end
