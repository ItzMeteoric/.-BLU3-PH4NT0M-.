local currentTarget = nil

local function findRaft()
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            if n:find("foundation") or n:find("floor") or n:find("raft") or n:find("platform") then
                if obj.Parent and not obj.Parent:IsA("Player") then return obj end
            end
        end
    end
    return nil
end

local function teleportToRaft()
    local c = PL.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local t = findRaft()
    if t then
        r.CFrame = CFrame.new(t.Position + Vector3.new(0, 3, 0))
        local n = Instance.new("TextLabel") n.Size=UDim2.new(0,200,0,30) n.Position=UDim2.new(0.5,-100,0.5,-50) n.BackgroundColor3=Color3.fromRGB(0,150,100) n.BackgroundTransparency=0.3 n.Text="🏠 TELEPORTED TO RAFT!" n.TextColor3=Color3.fromRGB(255,255,255) n.TextSize=12 n.Font=Enum.Font.GothamBold n.Parent=MG
        Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
        task.wait(1.5) n:Destroy()
    end
end

local function teleportToLoot()
    local c = PL.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local closest, closestDist = nil, math.huge
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            if n:find("barrel") or n:find("crate") or n:find("chest") then
                if obj.Parent and not obj.Parent:IsA("Player") then
                    local id = getBarrelId(obj)
                    if not emptyBarrels[id] then
                        local d = (obj.Position - r.Position).Magnitude
                        if d < closestDist then closestDist, closest = d, obj end
                    end
                end
            end
        end
    end
    if closest then
        currentTarget = closest
        r.CFrame = CFrame.new(closest.Position + Vector3.new(0, 2, 0))
        local n = Instance.new("TextLabel") n.Size=UDim2.new(0,220,0,30) n.Position=UDim2.new(0.5,-110,0.5,-50) n.BackgroundColor3=Color3.fromRGB(0,150,100) n.BackgroundTransparency=0.3 n.Text="🎯 TELEPORTED TO LOOT!" n.TextColor3=Color3.fromRGB(255,255,255) n.TextSize=11 n.Font=Enum.Font.GothamBold n.Parent=MG
        Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
        task.wait(1.5) n:Destroy()
    else
        local n = Instance.new("TextLabel") n.Size=UDim2.new(0,220,0,30) n.Position=UDim2.new(0.5,-110,0.5,-50) n.BackgroundColor3=Color3.fromRGB(150,50,50) n.BackgroundTransparency=0.3 n.Text="❌ NO UNMARKED LOOT FOUND!" n.TextColor3=Color3.fromRGB(255,255,255) n.TextSize=11 n.Font=Enum.Font.GothamBold n.Parent=MG
        Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
        task.wait(2) n:Destroy()
    end
end

local function markCurrent()
    if not currentTarget then
        local c = PL.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r then
            local closest, closestDist = nil, 10
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj:IsA("BasePart") and (string.lower(obj.Name):find("barrel") or string.lower(obj.Name):find("crate")) then
                    local d = (obj.Position - r.Position).Magnitude
                    if d < closestDist then closestDist, closest = d, obj end
                end
            end
            currentTarget = closest
        end
    end
    if currentTarget then
        local id = getBarrelId(currentTarget)
        emptyBarrels[id] = true
        local n = Instance.new("TextLabel") n.Size=UDim2.new(0,220,0,30) n.Position=UDim2.new(0.5,-110,0.5,-50) n.BackgroundColor3=Color3.fromRGB(0,150,100) n.BackgroundTransparency=0.3 n.Text="🗑️ BARREL MARKED AS EMPTY!" n.TextColor3=Color3.fromRGB(255,255,255) n.TextSize=12 n.Font=Enum.Font.GothamBold n.Parent=MG
        Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
        task.wait(1.5) n:Destroy()
        currentTarget = nil
    end
end

